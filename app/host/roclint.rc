#include <windows.h>
IDI_ROCLINT ICON "../qml/shell/assets/roclint.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Roclint\0"
            VALUE "ProductName", "Roclint\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "ProductVersion", "0.1.0\0"
            VALUE "OriginalFilename", "roclint_host.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
