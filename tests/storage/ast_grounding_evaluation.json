      "note": "Grounding binds the indexed bytes; the host must reject currentness after a byte change.",
      "files": {
        "src/stale.hpp": "class Stale { public: int value; };\n"
      },
      "mutate": {
        "src/stale.hpp": "class Stale { public: int value; int extra; };\n"
      },
      "activeFile": "src/stale.hpp",
      "intent": {
        "action": "MODIFY",
        "target": "value",
        "property": "name",
        "value": "changed",
        "condition": "in Stale"
      },
      "expected": {
        "status": "Verified",
        "target": "Stale::value",
        "file": "src/stale.hpp",
        "signatureContains": "int value",
        "matchReason": "scope",
        "complete": true,
        "hashValidatedDefault": true,
        "validateFileHash": false,
        "hostPromotes": false
      },
      "group": "stale",
      "split": "smoke"
